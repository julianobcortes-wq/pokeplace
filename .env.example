# Catálogo PokePlace (Supabase/Postgres). Sem estes valores o site usa a amostra local da TCGdex.
# Preços de carta: GET https://api.tcgdex.net (sem chave). Não há variável para isso.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Canais — somente nomes. Não coloque segredo neste arquivo versionado.
# Mercado Livre (OAuth authorization code)
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Shopee Open Platform (partner id + HMAC)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=

# Amazon Selling Partner API (Login with Amazon). Marketplace Brasil: A2Q3Y263D00KWC
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=

# Magalu (OAuth do seller)
MAGALU_CLIENT_ID=
MAGALU_CLIENT_SECRET=

# Americanas / SkyHub (API key, não OAuth)
AMERICANAS_USER_EMAIL=
AMERICANAS_API_KEY=
AMERICANAS_ACCOUNT_KEY=

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# TCGplayer (canal de venda; a vitrine de preço não usa estas chaves)
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=
